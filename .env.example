# ─────────────────────────────────────────────────────────────────────────────
# Copy file này thành .env và sửa giá trị theo môi trường (local vs prod).
# docker-compose.yml đọc file .env này tự động.
#
# ĐỌC TRƯỚC KHI DEPLOY LẦN ĐẦU — ba chỗ sai là hỏng cả bản dựng:
#   1. NEXT_PUBLIC_* được nướng cứng vào bundle lúc BUILD. Sai là phải build
#      lại, khởi động lại không cứu được. next.config.mjs sẽ chặn build nếu
#      chúng còn trỏ về localhost.
#   2. JWT_SECRET / JWT_REFRESH_SECRET phải đổi. Để nguyên chuỗi mẫu thì ai đọc
#      được mã nguồn cũng ký được token quản trị.
#   3. FORCE_RESEED=1 sẽ XOÁ TRẮNG cơ sở dữ liệu rồi nạp lại từ snapshot.
#      Trên máy chủ thật, đừng khai biến này.
# ─────────────────────────────────────────────────────────────────────────────

# ── Múi giờ ─────────────────────────────────────────────────────────────────
# CSDL ghi giờ UTC vào cột không có múi giờ. Node phải đọc bằng UTC, không thì
# mọi mốc thời gian (ngày đăng, lastmod trong sitemap) lệch đúng một múi giờ.
# Trong Docker mặc định đã là UTC; chạy tay trên Windows/macOS thì phải đặt.
TZ=UTC

# ── Database ─────────────────────────────────────────────────────────────────
DB_USERNAME=postgres
# PROD: đổi sang mật khẩu dài, ngẫu nhiên. Sinh bằng:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
DB_PASSWORD=postgres
DB_DATABASE=news_db
DB_PORT_HOST=5433              # Port Postgres mở ra host (container vẫn dùng 5432)

# ── BE / FE ports trên host ──────────────────────────────────────────────────
# Máy chủ thật nên đặt reverse proxy (Nginx/Caddy) đứng trước hai port này.
BE_PORT=3001
FE_PORT=3000

# ── BE: JWT secrets ──────────────────────────────────────────────────────────
# PROD: BẮT BUỘC đổi cả hai. Mỗi chuỗi sinh riêng, không dùng lại của nhau:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret_too
JWT_REFRESH_EXPIRES_IN=30d

# ── BE: URL công khai và CORS ───────────────────────────────────────────────
# PUBLIC_URL chỉ còn dùng cho liên kết trong email và tài liệu API. Ảnh tải lên
# nay lưu đường dẫn tương đối "/uploads/<tệp>" nên không phụ thuộc biến này nữa.
# LOCAL:  PUBLIC_URL=http://localhost:3001
# PROD:   PUBLIC_URL=https://api.topungdung.net
PUBLIC_URL=http://localhost:3001
# Danh sách tên miền được phép gọi API từ trình duyệt, ngăn cách bằng dấu phẩy.
# PROD: CORS_ORIGINS=https://topungdung.net,https://www.topungdung.net
CORS_ORIGINS=http://localhost:3000

# ── BE: SMTP (gửi mail liên hệ) ─────────────────────────────────────────────
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=TopỨngDụng
CONTACT_RECEIVE_EMAIL=

# ── FE: build-time NEXT_PUBLIC_* ────────────────────────────────────────────
# QUAN TRỌNG: đổi giá trị ở đây thì phải REBUILD image FE, không phải restart.
# LOCAL:  http://localhost:3001  /  http://localhost:3000
# PROD:   https://api.topungdung.net  /  https://topungdung.net
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=TopỨngDụng
# Không cần khai: docker-compose tự đặt API_INTERNAL_URL=http://backend:3001 để
# SSR gọi backend qua mạng nội bộ. Chỉ khai khi chạy FE ngoài compose.

# Khoá cho POST /api/revalidate của FE (gửi qua header x-revalidate-secret).
# Thiếu khoá này thì endpoint bị khoá và nội dung sửa trong admin không hiện ra
# ngay. Sinh bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
REVALIDATE_SECRET=

# ── Seed control ────────────────────────────────────────────────────────────
# FORCE_RESEED=1 → khi container start sẽ TRUNCATE toàn bộ DB rồi restore từ
# snapshot.json. Chỉ dùng khi dựng lại môi trường từ đầu. Trên máy chủ đang
# chạy thật, KHÔNG khai biến này.
FORCE_RESEED=0
